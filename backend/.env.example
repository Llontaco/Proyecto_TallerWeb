# Copiar a .env y completar. Nunca subir .env al repositorio.
DB_URL=jdbc:mysql://localhost:3306/sigsu?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=sigsu_app
DB_PASSWORD=cambiar
# Clave HMAC en Base64 de al menos 64 bytes. Generar con:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(64)).decode())"
JWT_SECRET=cambiar
JWT_EXPIRATION_HOURS=8
# Contraseña de los usuarios de demostración que se crean al iniciar con la base vacía
SEED_DEMO_PASSWORD=cambiar
SEED_ENABLED=true
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
UPLOADS_DIR=./uploads
