# nginx de SIGSU: sirve la SPA de React y actúa como API Gateway hacia Spring Boot.
#  - Un solo origen para el navegador (la cookie SameSite=Strict funciona sin CORS)
#  - Límite de peticiones por IP (login más estricto contra fuerza bruta)
#  - Cabeceras de seguridad y caché de archivos estáticos

# IP real del cliente: en Render la petición pasa por Cloudflare y por el balanceador
# interno, y llega con X-Forwarded-For: "cliente, IP de Cloudflare, IP interna de Render".
# nginx recorre esa lista de derecha a izquierda saltando los proxies de confianza
# (red interna + rangos publicados de Cloudflare) y se queda con la IP del cliente.
# Así el límite de peticiones se aplica por usuario y no a todos juntos.
# En docker compose local no hay X-Forwarded-For y se usa la IP de conexión.
real_ip_header X-Forwarded-For;
real_ip_recursive on;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 127.0.0.1;
# Cloudflare (https://www.cloudflare.com/ips/)
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;

limit_req_zone $binary_remote_addr zone=login:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;

server {
    listen 80;
    server_name _;
    server_tokens off;
    client_max_body_size 16m;
    root /usr/share/nginx/html;

    # Salud del gateway (la usa Docker y el proveedor cloud)
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Login: máximo 20 intentos por minuto por IP
    location = /api/auth/login {
        limit_req zone=login burst=10 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/seguridad.conf;
        proxy_pass ${BACKEND_URL};
    }

    # Resto de la API REST
    location /api/ {
        limit_req zone=api burst=60 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/seguridad.conf;
        proxy_pass ${BACKEND_URL};
    }

    # Documentación OpenAPI / Swagger UI (sin CSP estricta, Swagger usa estilos en línea)
    location ~ ^/(swagger-ui|swagger-ui\.html|v3/api-docs) {
        include /etc/nginx/snippets/proxy.conf;
        add_header X-Content-Type-Options "nosniff" always;
        proxy_pass ${BACKEND_URL};
    }

    # Archivos con hash en el nombre: caché de 1 año
    location /assets/ {
        include /etc/nginx/snippets/seguridad.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA: cualquier otra ruta devuelve index.html (React Router decide)
    location / {
        include /etc/nginx/snippets/seguridad.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
