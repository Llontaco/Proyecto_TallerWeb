# Variables de Docker Compose. Copiar a .env y completar. Nunca subir .env al repositorio.
APP_PORT=8088
APP_URL=http://localhost:8088
DB_USER=sigsu_app
DB_PASSWORD=cambiar
DB_ROOT_PASSWORD=cambiar
# Clave HMAC en Base64 de 64 bytes:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(64)).decode())"
JWT_SECRET=cambiar
COOKIE_SECURE=false
SEED_ENABLED=true
SEED_DEMO_PASSWORD=cambiar
# Correo opcional para notificaciones (SMTP)
NOTIF_CORREO_HABILITADO=false
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
