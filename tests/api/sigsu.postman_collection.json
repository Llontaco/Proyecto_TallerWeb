{
  "info": {
    "name": "SIGSU API – pruebas automatizadas",
    "description": "Fase III: pruebas de la API REST a través del gateway nginx. Ejecutar con: npx newman run tests/api/sigsu.postman_collection.json -e tests/api/local.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Gateway y documentación",
      "item": [
        {
          "name": "Salud del gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "OpenAPI publicada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Título y rutas documentadas', () => { const j = pm.response.json(); pm.expect(j.info.title).to.eql('SIGSU API'); pm.expect(j.paths).to.have.property('/api/solicitudes'); pm.expect(j.paths).to.have.property('/api/notificaciones'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v3/api-docs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v3",
                "api-docs"
              ]
            }
          }
        }
      ]
    },
