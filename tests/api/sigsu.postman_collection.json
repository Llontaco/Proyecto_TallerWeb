    {
      "name": "3. Flujo end-to-end de una solicitud",
      "item": [
        {
          "name": "Catálogos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Hay categorías, prioridades y 6 estados', () => { pm.expect(j.categorias.length).to.be.above(0); pm.expect(j.prioridades.length).to.be.above(0); pm.expect(j.estados.length).to.eql(6); });",
                  "pm.collectionVariables.set('categoriaId', j.categorias[0].id);",
                  "pm.collectionVariables.set('prioridadId', j.prioridades[1].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEst}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/catalogos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalogos"
              ]
            }
          }
        },
        {
          "name": "Registrar con datos incompletos -> 400",
