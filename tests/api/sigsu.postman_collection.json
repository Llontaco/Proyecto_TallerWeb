            "body": {
              "mode": "raw",
              "raw": "{\"categoriaId\":{{categoriaId}},\"prioridadId\":{{prioridadId}},\"ubicacion\":\"Pabellón C – Aula 302 (3er piso)\",\"descripcion\":\"La pizarra digital del aula 302 no responde al tacto.\"}"
