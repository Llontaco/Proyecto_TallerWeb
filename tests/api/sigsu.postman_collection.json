        },
        {
          "name": "Registrar solicitud -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created con Location', () => { pm.response.to.have.status(201); pm.expect(pm.response.headers.get('Location')).to.match(/\\/api\\/solicitudes\\/\\d+$/); });",
                  "const j = pm.response.json();",
                  "pm.test('Código único y estado Registrada', () => { pm.expect(j.codigo).to.match(/^SOL-\\d{4}-\\d{5}$/); pm.expect(j.estado).to.eql('REGISTRADA'); });",
                  "pm.collectionVariables.set('solicitudId', j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEst}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"categoriaId\":{{categoriaId}},\"prioridadId\":{{prioridadId}},\"ubicacion\":\"Pabellón C – Aula 302\",\"descripcion\":\"La pizarra digital del aula 302 no responde al tacto.\"}"
            }
